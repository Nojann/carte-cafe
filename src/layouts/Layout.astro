---
import '@fontsource-variable/bricolage-grotesque';
import '../styles/global.css';
import { langs, defaultLang, useTranslations, type Lang } from '../i18n/ui';
import { siteJsonLd } from '../lib/jsonld';
import { withBase, cartPath } from '../lib/paths';
import { themeCss, themeColors, defaultTheme } from '../data/themes';
import { site } from '../site.config';

interface Props {
  lang: Lang;
  /** Libellé de la page seul : la marque est ajoutée automatiquement (« Libellé — Marque »). */
  title: string;
  description: string;
  /** Chemin de la page sans la langue : `/`, `/boutique/`, `/panier/`, `/contact/`. */
  path?: string;
  /** Page exclue des moteurs (panier, outils internes) : ni canonical ni hreflang, absente du sitemap. */
  noindex?: boolean;
  /** Image de partage (réseaux sociaux). Format paysage ≈ 1.91:1, au moins 1200 px de large. */
  image?: { src: string; width: number; height: number; alt: string };
}
const { lang, title, description, path = '/', noindex = false } = Astro.props;
const t = useTranslations(lang);
const fullTitle = `${title} — ${site.brand}`;
const pageUrl = (l: Lang) => new URL(withBase(`/${l}${path}`), Astro.site);
const canonical = pageUrl(lang);
// x-default : la page racine (choix de la langue) pour l'accueil, la version française ailleurs.
const xDefault = path === '/' ? new URL(withBase('/'), Astro.site) : pageUrl(defaultLang);
const ogLocales: Record<Lang, string> = { fr: 'fr_FR', en: 'en_GB', es: 'es_ES' };
const image = Astro.props.image ?? {
  src: '/images/couple-producteurs-portrait.webp',
  width: 2400,
  height: 1258,
  alt: t('origins.storyAlt'),
};
const imageUrl = new URL(withBase(image.src), Astro.site);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {
      noindex ? (
        <meta name="robots" content="noindex, follow" />
      ) : (
        <>
          <link rel="canonical" href={canonical} />
          {langs.map((l) => <link rel="alternate" hreflang={l} href={pageUrl(l)} />)}
          <link rel="alternate" hreflang="x-default" href={xDefault} />
          <link rel="sitemap" type="application/xml" href={withBase('/sitemap.xml')} />
        </>
      )
    }
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.brand} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    {!noindex && <meta property="og:url" content={canonical} />}
    <meta property="og:locale" content={ogLocales[lang]} />
    {langs.filter((l) => l !== lang).map((l) => <meta property="og:locale:alternate" content={ogLocales[l]} />)}
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:type" content="image/webp" />
    <meta property="og:image:width" content={String(image.width)} />
    <meta property="og:image:height" content={String(image.height)} />
    <meta property="og:image:alt" content={image.alt} />
    <meta name="twitter:card" content="summary_large_image" />
    {!noindex && <script type="application/ld+json" set:html={JSON.stringify(siteJsonLd(lang, Astro.site))} />}
    <link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" />
    <meta name="theme-color" content={themeColors[defaultTheme]} />
    <style is:inline set:html={themeCss}></style>
    <script is:inline define:vars={{ themeColors }}>
      document.documentElement.classList.add('js');
      // Nuancier choisi sur /coolors (appliqué avant le rendu pour éviter un flash)
      try {
        const theme = localStorage.getItem('theme');
        if (theme && themeColors[theme]) {
          document.documentElement.dataset.theme = theme;
          document.querySelector('meta[name="theme-color"]')?.setAttribute('content', themeColors[theme]);
        }
      } catch {}
    </script>
    <slot name="head" />
  </head>
  <body>
    <slot />
    <!-- Confirmation d'ajout au panier (src/scripts/cart.ts) -->
    <div class="toast" data-toast role="status" aria-live="polite" hidden>
      <p class="toast__text" data-toast-text></p>
      <a class="link link--strong" href={cartPath(lang)}>{t('cart.view')} <span aria-hidden="true">→</span></a>
      <button type="button" class="icon-btn toast__close" data-toast-close aria-label={t('cart.close')}>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" /></svg>
      </button>
    </div>
    <script>
      import { initCart } from '../scripts/cart';
      initCart();
    </script>
  </body>
</html>
