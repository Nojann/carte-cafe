---
// Panneau d'une région colombienne : présentation + liste de ses cafés.
import { countryName, formatPrice, minPrice, quickItem, type Cafe, type Region } from '../lib/cafes';
import { useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  region: Region;
  cafes: Cafe[];
}
const { lang, region, cafes } = Astro.props;
const t = useTranslations(lang);
const soon = cafes.length === 0;
const count = t(cafes.length === 1 ? 'region.count.one' : 'region.count.other', { n: cafes.length });

/** Prix d'appel : plus petit format de la torréfaction disponible la moins chère ; « dès » si les prix diffèrent. */
function priceOf(cafe: Cafe) {
  const min = minPrice(cafe);
  if (!min) return null;
  const amount = formatPrice(min.format.montant, min.roast.devise, lang);
  return {
    label: min.from ? t('region.from', { price: amount }) : amount,
    per: t('sheet.per', { g: min.format.poids_g }),
  };
}
---

<article
  class="sheet sheet--region"
  id={`region-sheet-${region.slug}`}
  data-sheet={region.slug}
  data-kind="region"
  aria-labelledby={`title-region-${region.slug}`}
>
  <span class="anchor" id={`region-${region.slug}`}></span>
  <div class="sheet__bar">
    <button type="button" class="icon-btn sheet__close" data-close aria-label={t('sheet.close')}>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" /></svg>
    </button>
  </div>
  <header class="sheet__header">
    <p class="sheet__origin">{countryName('CO', lang)} · {t('region.kind')}</p>
    <h3 class="sheet__title" id={`title-region-${region.slug}`} tabindex="-1">{region.nom}</h3>
  </header>
  {region.description && <p class="sheet__story">{region.description[lang]}</p>}

  {
    soon ? (
      <div class="region-soon">
        <span class="badge badge--soon">{t('region.soon')}</span>
        <p>{t('region.soonText')}</p>
      </div>
    ) : (
      <h4 class="region-list__title">{t('region.cafes')} <span class="pill pill--small">{count}</span></h4>
    )
  }
  <ul class="region-list">
    {
      cafes.map((c) => {
        const price = priceOf(c);
        return (
          <li class:list={['region-item', { 'is-soldout': !c.disponible }]}>
            <a href={`#${c.slug}`} data-goto={c.slug} class="region-cafe">
              <svg class="region-cafe__icon" viewBox="0 0 24 30" aria-hidden="true"><use href="#i-plant" /></svg>
              <span class="region-cafe__text">
                <strong>{c.nom[lang]}</strong>
                {c.producteur && <span>{c.producteur}</span>}
                <span class="region-cafe__notes">{c.notes[lang].join(' · ')}</span>
              </span>
              <svg class="region-cafe__chevron" viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5l7 7-7 7" /></svg>
            </a>
            <div class="region-item__buy">
              {c.disponible ? (
                <>
                  {price && (
                    <p class="price">
                      <strong>{price.label}</strong> {price.per}
                    </p>
                  )}
                  <button
                    type="button"
                    class="btn"
                    data-add-to-cart
                    data-item={quickItem(c)}
                    data-name={c.nom[lang]}
                    data-added={t('shop.added')}
                    aria-label={`${t('shop.add')} : ${c.nom[lang]}`}
                  >
                    {t('sheet.buyShort')}
                  </button>
                </>
              ) : (
                <span class="badge badge--soldout">{t('sheet.soldOut')}</span>
              )}
            </div>
          </li>
        );
      })
    }
  </ul>
</article>
