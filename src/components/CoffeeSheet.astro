---
import {
  countryName,
  flagDataUri,
  formatAltitude,
  formatDistance,
  formatPrice,
  formatWeight,
  offersOf,
  photoExists,
  pickPhoto,
  type Cafe,
  type Region,
} from '../lib/cafes';
import { site } from '../site.config';
import { withBase } from '../lib/paths';
import { useTranslations, type Lang, type UIKey } from '../i18n/ui';

interface Props {
  lang: Lang;
  cafe: Cafe;
  region: Region;
  prev: Cafe;
  next: Cafe;
}
const { lang, cafe, region, prev, next } = Astro.props;
const t = useTranslations(lang);
// Première photo du café présente sur le disque, sinon photo de la région, sinon drapeau.
const photo = pickPhoto(cafe, region);
const offers = offersOf(cafe, lang);
const hasPhoto = photoExists(photo.src);

const details: [string, string | undefined][] = [
  [t('sheet.producer'), cafe.producteur],
  [t('sheet.altitude'), cafe.altitude && formatAltitude(cafe.altitude, lang)],
  [t('sheet.varieties'), cafe.varietes?.join(', ')],
  [t('sheet.process'), cafe.process && t(`process.${cafe.process}`)],
  [t('sheet.harvest'), cafe.recolte],
  [t('sheet.distance', { city: site.roastery.name }), formatDistance(cafe, lang)],
];
const profile: [UIKey, number][] = cafe.profil
  ? [
      ['sheet.acidity', cafe.profil.acidite],
      ['sheet.body', cafe.profil.corps],
      ['sheet.sweetness', cafe.profil.douceur],
    ]
  : [];
const origin = [countryName(cafe.pays, lang), region.nom, cafe.localite].filter(Boolean).join(' · ');
---

<article
  class="sheet"
  id={`cafe-${cafe.slug}`}
  data-sheet={cafe.slug}
  data-kind="cafe"
  data-cafe-region={region.slug}
  aria-labelledby={`title-${cafe.slug}`}
>
  <span class="anchor" id={cafe.slug}></span>
  <div class="sheet__bar">
    <a class="chip-btn" href={`#region-${region.slug}`} data-region={region.slug} aria-label={t('region.back', { region: region.nom })}>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5l-7 7 7 7" /></svg>
      {region.nom}
    </a>
    <a class="icon-btn" href={`#${prev.slug}`} data-goto={prev.slug} aria-label={`${t('sheet.prev')} : ${prev.nom[lang]}`}>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5l-7 7 7 7" /></svg>
    </a>
    <a class="icon-btn" href={`#${next.slug}`} data-goto={next.slug} aria-label={`${t('sheet.next')} : ${next.nom[lang]}`}>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5l7 7-7 7" /></svg>
    </a>
    <button type="button" class="icon-btn sheet__close" data-close aria-label={t('sheet.close')}>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" /></svg>
    </button>
  </div>

  <figure class="sheet__photo">
    {
      hasPhoto ? (
        <img src={withBase(photo.src)} alt={photo.alt[lang]} loading="lazy" decoding="async" width="800" height="500" />
      ) : (
        <div class="sheet__placeholder" role="img" aria-label={photo.alt[lang]}>
          <img src={flagDataUri(cafe.pays)} alt="" width="800" height="600" />
        </div>
      )
    }
    {!cafe.disponible && <span class="badge badge--soldout">{t('sheet.soldOut')}</span>}
  </figure>

  <header class="sheet__header">
    <p class="sheet__origin">{origin}</p>
    <h3 class="sheet__title" id={`title-${cafe.slug}`} tabindex="-1">{cafe.nom[lang]}</h3>
  </header>

  {cafe.histoire && <p class="sheet__story">{cafe.histoire[lang]}</p>}

  <ul class="tags" aria-label={t('sheet.notes')}>
    {cafe.notes[lang].map((n) => <li>{n}</li>)}
  </ul>

  <dl class="facts">
    {
      details
        .filter(([, v]) => v)
        .map(([k, v]) => (
          <div>
            <dt>{k}</dt>
            <dd>{v}</dd>
          </div>
        ))
    }
  </dl>

  {
    profile.length > 0 && (
      <div class="profile">
        <h4>{t('sheet.profile')}</h4>
        {profile.map(([k, v]) => (
          <div class="profile__row">
            <span>{t(k)}</span>
            <span class="profile__dots" role="img" aria-label={`${t(k)} : ${t('sheet.outOf5', { v })}`}>
              {[1, 2, 3, 4, 5].map((i) => (
                <i class:list={{ on: i <= v }} />
              ))}
            </span>
          </div>
        ))}
      </div>
    )
  }

  <div class="roasts">
    <h4>{t('sheet.roasts')}</h4>
    <ul>
      {
        cafe.torrefactions.map((r) => (
          <li class:list={['roast', { 'is-soldout': !r.disponible }]}>
            <form
              class="roast__form"
              data-product={cafe.slug}
              data-name={cafe.nom[lang]}
              data-added={t('shop.added')}
              data-offers={offers}
            >
              <input type="hidden" name="roast" value={r.niveau} />
              <div class="roast__info">
                <strong>{t(`roast.${r.niveau}`)}</strong>
                <span>{t(`usage.${r.usage}`)}</span>
              </div>
              <p class="price">
                <strong data-price>{formatPrice(r.formats[0].montant, r.devise, lang)}</strong>
              </p>
              {r.disponible ? (
                <div class="roast__buy">
                  <label class="visually-hidden" for={`size-${cafe.slug}-${r.niveau}`}>{t('sheet.format')}</label>
                  <select class="select" name="size" id={`size-${cafe.slug}-${r.niveau}`}>
                    {r.formats.map((f) => (
                      <option value={f.poids_g}>{formatWeight(f.poids_g, lang)}</option>
                    ))}
                  </select>
                  <button type="submit" class="btn" aria-label={`${t('shop.add')} : ${cafe.nom[lang]}, ${t(`roast.${r.niveau}`)}`}>
                    {t('sheet.add')}
                  </button>
                </div>
              ) : (
                <span class="badge badge--soldout">{t('sheet.soldOut')}</span>
              )}
            </form>
          </li>
        ))
      }
    </ul>
  </div>
</article>
