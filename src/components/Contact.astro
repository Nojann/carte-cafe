---
// Bloc contact : e-mail et téléphone (révélés à la demande), Instagram, food trucks.
// - variant « section » : section de l'accueil, entre « Tous nos cafés » et « Notre démarche » ;
// - variant « page » : contenu de la page /[lang]/contact/ (le titre est dans l'en-tête de page).
import ContactReveal from './ContactReveal.astro';
import { useTranslations, type Lang } from '../i18n/ui';
import { site } from '../site.config';
import { getData, formatDates } from '../lib/cafes';
import { contactEmail, contactPhone } from '../lib/contact';
import { contactPath, homePath } from '../lib/paths';

interface Props {
  lang: Lang;
  variant: 'section' | 'page';
}
const { lang, variant } = Astro.props;
const t = useTranslations(lang);
const { places } = await getData();
const hasEmail = contactEmail() !== null;
const hasPhone = contactPhone() !== null;
const isPage = variant === 'page';
const Heading = isPage ? 'h2' : 'h3';
---

<section class:list={['contact', `contact--${variant}`]} id={isPage ? undefined : 'contact'} aria-labelledby={isPage ? undefined : 'contact-title'}>
  <div class="wrap contact__inner">
    {
      !isPage && (
        <div class="contact__head">
          <p class="eyebrow"><span>{t('contact.eyebrow')}</span></p>
          <h2 id="contact-title" class="display">{t('contact.title')}</h2>
          <p class="contact__intro">{t('contact.intro')}</p>
          <a class="link contact__more" href={contactPath(lang)}>{t('contact.more')} <span aria-hidden="true">→</span></a>
        </div>
      )
    }

    <ul class="contact__cards" role="list">
      {
        hasEmail && (
          <li class="contact-card contact-card--email">
            <span class="contact-card__icon" aria-hidden="true">
              <svg viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="14" rx="2.5" /><path d="m4 7 8 6 8-6" /></svg>
            </span>
            <Heading class="contact-card__title">{t('contact.email')}</Heading>
            <p class="contact-card__text">{t('contact.emailText')}</p>
            <ContactReveal lang={lang} subject={t('contact.subject')} />
          </li>
        )
      }
      {
        hasPhone && (
          <li class="contact-card contact-card--phone">
            <span class="contact-card__icon" aria-hidden="true">
              <svg viewBox="0 0 24 24"><path d="M5 3.5h3.2l1.6 4.2-2.1 1.4a11 11 0 0 0 5.2 5.2l1.4-2.1 4.2 1.6V17a2 2 0 0 1-2.2 2A15.5 15.5 0 0 1 3 5.7 2 2 0 0 1 5 3.5Z" /></svg>
            </span>
            <Heading class="contact-card__title">{t('contact.phone')}</Heading>
            <p class="contact-card__text">{t('contact.phoneText')}</p>
            <ContactReveal lang={lang} kind="phone" />
          </li>
        )
      }
      <li class="contact-card contact-card--instagram">
        <span class="contact-card__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24"><rect x="3.5" y="3.5" width="17" height="17" rx="5" /><circle cx="12" cy="12" r="4" /><circle cx="17.2" cy="6.8" r="0.6" /></svg>
        </span>
        <Heading class="contact-card__title">{t('contact.instagram')}</Heading>
        <p class="contact-card__text">{t('contact.instagramText')}</p>
        <a class="btn btn--ghost contact-card__cta" href={site.instagram} rel="noopener">
          {t('contact.instagramCta')} <span aria-hidden="true">↗</span>
        </a>
      </li>
      {
        places.length > 0 && (
          <li class="contact-card contact-card--truck">
            <span class="contact-card__icon" aria-hidden="true">
              <svg viewBox="0 0 24 24"><path d="M2.5 16V7.5A1.5 1.5 0 0 1 4 6h10v10" /><path d="M14 9h4l3.5 4v3H14" /><circle cx="7" cy="17" r="2" /><circle cx="17.5" cy="17" r="2" /></svg>
            </span>
            <Heading class="contact-card__title">{t('contact.find')}</Heading>
            <p class="contact-card__text">{t('contact.findText')}</p>
            <ul class="contact-places" role="list">
              {places.map((p) => (
                <li>
                  <a class="link contact-places__name" href={`${homePath(lang)}#lieu-${p.slug}`}>{p.nom[lang]}</a>
                  <span class="contact-places__meta">
                    {t(`place.type.${p.type}`)}
                    {p.exemple && <> · {t('place.example')}</>}
                  </span>
                  {isPage && <span class="contact-places__detail">{p.dates ? formatDates(p.dates, lang) : p.horaires[lang]}</span>}
                  {isPage && <span class="contact-places__detail">{p.adresse}</span>}
                </li>
              ))}
            </ul>
          </li>
        )
      }
    </ul>
  </div>
</section>
