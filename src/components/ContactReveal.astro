---
// Bouton « Afficher l'adresse e-mail » / « Afficher le numéro ». La valeur est encodée au build
// (src/lib/contact.ts) et décodée dans le navigateur après un vrai clic (src/scripts/contact.ts).
import { useTranslations, type Lang } from '../i18n/ui';
import { contactEmail, contactPhone } from '../lib/contact';

interface Props {
  lang: Lang;
  kind?: 'email' | 'phone';
  /** E-mail : objet pré-rempli. */
  subject?: string;
  /** E-mail, page panier : début du mail, suivi des lignes du panier. */
  cartIntro?: string;
  /** Texte du bouton (par défaut « Afficher l'adresse e-mail » / « Afficher le numéro »). */
  label?: string;
  /** Bouton secondaire (blanc) quand plusieurs boutons se suivent. */
  ghost?: boolean;
}
const { lang, kind = 'email', subject, cartIntro, label, ghost = false } = Astro.props;
const t = useTranslations(lang);
const parts = kind === 'email' ? contactEmail() : contactPhone();
const isEmail = kind === 'email';
const icon = isEmail
  ? '<rect x="3" y="5" width="18" height="14" rx="2.5" /><path d="m4 7 8 6 8-6" />'
  : '<path d="M5 3.5h3.2l1.6 4.2-2.1 1.4a11 11 0 0 0 5.2 5.2l1.4-2.1 4.2 1.6V17a2 2 0 0 1-2.2 2A15.5 15.5 0 0 1 3 5.7 2 2 0 0 1 5 3.5Z" />';
---

{
  parts && (
    <div
      class="contact-reveal"
      data-contact-box
      data-kind={kind}
      data-parts={parts.join('.')}
      data-subject={subject}
      data-cart-intro={cartIntro}
    >
      {/* Piège à robots : invisible et hors du parcours clavier. */}
      <a href="#" class="contact-reveal__trap" data-contact-trap tabindex="-1" aria-hidden="true">{isEmail ? 'e-mail' : 'tel'}</a>
      <button type="button" class:list={['btn contact-reveal__button', { 'btn--ghost': ghost }]} data-contact-reveal>
        <svg viewBox="0 0 24 24" aria-hidden="true" set:html={icon} />
        {label ?? t(isEmail ? 'contact.reveal' : 'contact.phoneReveal')}
      </button>
      <div class="contact-reveal__result" data-contact-result hidden>
        <a class="contact-reveal__link" data-contact-link href="#">
          <svg viewBox="0 0 24 24" aria-hidden="true" set:html={icon} />
          <span data-contact-value></span>
        </a>
        <button
          type="button"
          class="chip-btn contact-reveal__copy"
          data-contact-copy
          data-copied={t(isEmail ? 'contact.copied' : 'contact.phoneCopied')}
          aria-label={t(isEmail ? 'contact.copyLabel' : 'contact.phoneCopyLabel')}
          hidden
        >
          <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="8" y="8" width="12" height="12" rx="2" /><path d="M16 8V5.5A1.5 1.5 0 0 0 14.5 4h-9A1.5 1.5 0 0 0 4 5.5v9A1.5 1.5 0 0 0 5.5 16H8" /></svg>
          {t('contact.copy')}
        </button>
      </div>
      <p class="contact-reveal__status small" data-contact-status role="status" aria-live="polite"></p>
      <noscript><p class="small">{t(isEmail ? 'contact.noscript' : 'contact.phoneNoscript')}</p></noscript>
    </div>
  )
}
