---
import Layout from '../../layouts/Layout.astro';
import WorldMap from '../../components/WorldMap.astro';
import CoffeeSheet from '../../components/CoffeeSheet.astro';
import RegionSheet from '../../components/RegionSheet.astro';
import PlaceSheet from '../../components/PlaceSheet.astro';
import RoasterySheet from '../../components/RoasterySheet.astro';
import { getData, countryName, buyUrl, mainRoast } from '../../lib/cafes';
import { languages, langs, useTranslations, type Lang } from '../../i18n/ui';
import { site } from '../../site.config';
import { withBase } from '../../lib/paths';

export function getStaticPaths() {
  return langs.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);
const { regions, cafes, places } = await getData();
const regionBySlug = new Map(regions.map((r) => [r.slug, r]));
const cafesOf = (slug: string) => cafes.filter((c) => c.region === slug);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: t('map.title'),
  itemListElement: cafes.map((c, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    item: {
      '@type': 'Product',
      name: c.nom[lang],
      description: c.histoire?.[lang] ?? c.notes[lang].join(', '),
      brand: { '@type': 'Brand', name: site.brand },
      countryOfOrigin: countryName(c.pays, lang),
      offers: c.torrefactions
        .filter((r) => r.prix)
        .map((r) => ({
          '@type': 'Offer',
          name: t(`roast.${r.niveau}`),
          price: r.prix!.montant,
          priceCurrency: r.prix!.devise,
          availability: `https://schema.org/${r.disponible ? 'InStock' : 'OutOfStock'}`,
          url: buyUrl(c, r, lang),
        })),
    },
  })),
};
---

<Layout lang={lang} title={t('meta.title')} description={t('meta.description')}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <link slot="head" rel="preload" as="image" href={withBase('/video/video-bandeau-poster.webp')} type="image/webp" fetchpriority="high" />

  <div class="top">
    <header class="topbar wrap">
      <a class="brand" href={withBase(`/${lang}/`)}>
        <img class="brand__logo" src={withBase('/images/logo.avif')} alt={site.brand} width="154" height="154" />
      </a>
      <nav class="topbar__nav" aria-label="Navigation">
        <a href="#carte">{t('nav.map')}</a>
        <a href="#demarche">{t('nav.approach')}</a>
        <a href={site.shopUrl[lang]}>{t('nav.shop')}</a>
      </nav>
      <nav class="langs" aria-label={t('nav.language')}>
        {
          langs.map((l) => (
            <a href={withBase(`/${l}/`)} hreflang={l} lang={l} data-lang-link aria-current={l === lang ? 'true' : undefined}>
              <abbr title={languages[l]}>{l.toUpperCase()}</abbr>
            </a>
          ))
        }
      </nav>
    </header>

    <section class="hero wrap">
      <div class="hero__text">
        <p class="eyebrow"><span>{t('hero.eyebrow')}</span></p>
        <h1 class="hero__title">
          {t('hero.title.a')} <em>{t('hero.title.b')}</em>
        </h1>
        <div class="hero__foot">
          <p class="hero__subtitle">{t('hero.subtitle')}</p>
          <a class="btn btn--big" href="#carte">{t('hero.cta')} <span aria-hidden="true">↓</span></a>
        </div>
      </div>
      <figure class="hero__media" aria-hidden="true">
        <video
          class="hero__video"
          data-hero-video
          data-src={withBase('/video/video-bandeau.mp4')}
          poster={withBase('/video/video-bandeau-poster.webp')}
          width="540"
          height="960"
          muted
          loop
          playsinline
          disablepictureinpicture
          preload="none"
        ></video>
      </figure>
    </section>
  </div>


  <main>
    <section class="explorer" id="carte" aria-labelledby="carte-title" data-explorer>
      <div class="wrap">
        <div class="section-head">
          <h2 id="carte-title" class="display">{t('map.title')}</h2>
          <p class="pill">{t('map.count', { n: cafes.length, r: new Set(cafes.map((c) => c.region)).size })}</p>
        </div>

        <div class="origins-story">
          <figure class="origins-story__figure">
            <img
              class="origins-story__img"
              src={withBase('/images/producteurs-chargement-cheval-sacs-800.webp')}
              srcset={`${withBase('/images/producteurs-chargement-cheval-sacs-800.webp')} 800w, ${withBase('/images/producteurs-chargement-cheval-sacs.webp')} 1600w`}
              sizes="(min-width: 800px) 40vw, 100vw"
              width="1600"
              height="1066"
              loading="lazy"
              decoding="async"
              alt={t('origins.storyAlt')}
            />
            <figcaption class="origins-story__caption">{t('origins.caption')}</figcaption>
          </figure>
          <div class="origins-story__body">
            <p class="eyebrow"><span>{t('origins.eyebrow')}</span></p>
            <p class="origins-story__text">{t('origins.story')}</p>
            <a href="#region-narino" class="link link--strong">{t('origins.cta')} <span aria-hidden="true">→</span></a>
          </div>
        </div>

        <p class="explorer__lead" data-lead>{t('map.hint')}</p>

        <div class="explorer__body">
          <div class="explorer__map">
            <WorldMap lang={lang} regions={regions} cafes={cafes} places={places} />
          </div>

          <div class="explorer__panel" data-panel>
            <p class="explorer__hint" data-hint>{t('map.hint')}</p>
            {regions.map((region) => <RegionSheet lang={lang} region={region} cafes={cafesOf(region.slug)} />)}
            {
              cafes.map((cafe, i) => (
                <CoffeeSheet
                  lang={lang}
                  cafe={cafe}
                  region={regionBySlug.get(cafe.region)!}
                  prev={cafes[(i - 1 + cafes.length) % cafes.length]}
                  next={cafes[(i + 1) % cafes.length]}
                />
              ))
            }
            {
              places.map((place, i) => (
                <PlaceSheet
                  lang={lang}
                  place={place}
                  prev={places.length > 1 ? places[(i - 1 + places.length) % places.length] : undefined}
                  next={places.length > 1 ? places[(i + 1) % places.length] : undefined}
                />
              ))
            }
            <RoasterySheet lang={lang} />
            <button type="button" class="btn btn--ghost explorer__back" data-tomap hidden>
              <span aria-hidden="true">↑</span> {t('map.backToMap')}
            </button>
          </div>
        </div>
      </div>
    </section>

    <section class="catalog" aria-labelledby="catalog-title">
      <div class="wrap">
        <h2 id="catalog-title" class="display">{t('list.title')}</h2>
        {
          regions.map((region) => (
            <div class="catalog__group">
              <h3 class="catalog__region">{region.nom}</h3>
              {cafesOf(region.slug).length === 0 && (
                <p class="catalog__soon">
                  <span class="badge badge--soon">{t('region.soon')}</span> {t('region.soonText')}
                </p>
              )}
              <ul class="cards">
                {cafesOf(region.slug).map((c) => (
                  <li class:list={['card', { 'is-soldout': !c.disponible }]} data-card={c.slug}>
                    <p class="card__origin">
                      {countryName(c.pays, lang)} · {region.nom}
                      {c.localite && ` · ${c.localite}`}
                    </p>
                    <h4 class="card__title">{c.nom[lang]}</h4>
                    <p class="card__notes">{c.notes[lang].join(' · ')}</p>
                    <div class="card__actions">
                      <a href={`#${c.slug}`} data-show={c.slug} class="link">
                        {t('list.show')}
                      </a>
                      {c.disponible ? (
                        <a href={buyUrl(c, mainRoast(c), lang)} class="link link--strong" data-buy={c.slug}>
                          {t('sheet.buy')}
                        </a>
                      ) : (
                        <span class="badge badge--soldout">{t('sheet.soldOut')}</span>
                      )}
                    </div>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </section>

    <section class="approach" id="demarche" aria-labelledby="demarche-title">
      <div class="wrap">
        <h2 id="demarche-title" class="display">{t('approach.title')}</h2>
        <div class="approach__grid">
          {
            ([1, 2, 3] as const).map((i) => (
              <div class="approach__item">
                <span class="approach__num" aria-hidden="true">0{i}</span>
                <h3>{t(`approach.${i}.title`)}</h3>
                <p>{t(`approach.${i}.text`)}</p>
              </div>
            ))
          }
        </div>
      </div>
    </section>
  </main>

  <footer class="footer">
    <div class="wrap footer__inner">
      <p class="brand">{site.brand}</p>
      <ul>
        <li><a href={site.shopUrl[lang]}>{t('nav.shop')}</a></li>
        <li><a href={`mailto:${site.contactEmail}`}>{t('footer.contact')}</a></li>
        <li><a href={site.instagram}>Instagram</a></li>
        <li><a href="#">{t('footer.legal')}</a></li>
      </ul>
      <p class="small">{t('footer.examples')}</p>
    </div>
  </footer>

  <script>
    import { initExplorer } from '../../scripts/explorer';
    import { initHeroVideo } from '../../scripts/hero-video';
    initExplorer();
    initHeroVideo();
  </script>
</Layout>
