---
import Layout from '../../layouts/Layout.astro';
import WorldMap from '../../components/WorldMap.astro';
import CoffeeSheet from '../../components/CoffeeSheet.astro';
import RegionSheet from '../../components/RegionSheet.astro';
import PlaceSheet from '../../components/PlaceSheet.astro';
import RoasterySheet from '../../components/RoasterySheet.astro';
import Approach from '../../components/Approach.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { getData, countryName, quickItem } from '../../lib/cafes';
import { productJsonLd } from '../../lib/jsonld';
import { langs, useTranslations, type Lang } from '../../i18n/ui';
import { withBase } from '../../lib/paths';

export function getStaticPaths() {
  return langs.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);
const { regions, cafes, places } = await getData();
const regionBySlug = new Map(regions.map((r) => [r.slug, r]));
const cafesOf = (slug: string) => cafes.filter((c) => c.region === slug);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: t('map.title'),
  itemListElement: cafes.map((c, i) => ({ '@type': 'ListItem', position: i + 1, item: productJsonLd(c, lang, Astro.site) })),
};
---

<Layout lang={lang} title={t('meta.title')} description={t('meta.description')}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <link slot="head" rel="preload" as="image" href={withBase('/video/video-bandeau-poster.webp')} type="image/webp" fetchpriority="high" />

  <div class="top">
    <Header lang={lang} />

    <section class="hero wrap">
      <div class="hero__text">
        <p class="eyebrow"><span>{t('hero.eyebrow')}</span></p>
        <h1 class="hero__title">
          {t('hero.title.a')} <em>{t('hero.title.b')}</em>
        </h1>
        <div class="hero__foot">
          <p class="hero__subtitle">{t('hero.subtitle')}</p>
          <a class="btn btn--big" href="#carte">{t('hero.cta')} <span aria-hidden="true">↓</span></a>
        </div>
      </div>
      <figure class="hero__media" aria-hidden="true">
        <video
          class="hero__video"
          data-hero-video
          data-src={withBase('/video/video-bandeau.mp4')}
          poster={withBase('/video/video-bandeau-poster.webp')}
          width="540"
          height="960"
          muted
          loop
          playsinline
          disablepictureinpicture
          preload="none"
        ></video>
      </figure>
    </section>
  </div>


  <main>
    <section class="explorer" id="carte" aria-labelledby="carte-title" data-explorer>
      <div class="wrap">
        <div class="section-head">
          <h2 id="carte-title" class="display">{t('map.title')}</h2>
          <p class="pill">{t('map.count', { n: cafes.length, r: new Set(cafes.map((c) => c.region)).size })}</p>
        </div>

        <div class="origins-story">
          <figure class="origins-story__figure">
            <img
              class="origins-story__img"
              src={withBase('/images/couple-producteurs-portrait-800.webp')}
              srcset={`${withBase('/images/couple-producteurs-portrait-800.webp')} 800w, ${withBase('/images/couple-producteurs-portrait.webp')} 2400w`}
              sizes="(min-width: 800px) 40vw, 100vw"
              width="2400"
              height="1258"
              loading="lazy"
              decoding="async"
              alt={t('origins.storyAlt')}
            />
          </figure>
          <div class="origins-story__body">
            <p class="eyebrow"><span>{t('origins.eyebrow')}</span></p>
            <p class="origins-story__text">{t('origins.story')}</p>
            <a href="#region-narino" class="link link--strong">{t('origins.cta')} <span aria-hidden="true">→</span></a>
          </div>
        </div>

        <p class="explorer__lead" data-lead>{t('map.hint')}</p>

        <div class="explorer__body">
          <div class="explorer__map">
            <WorldMap lang={lang} regions={regions} cafes={cafes} places={places} />
          </div>

          <div class="explorer__panel" data-panel>
            <p class="explorer__hint" data-hint>{t('map.hint')}</p>
            {regions.map((region) => <RegionSheet lang={lang} region={region} cafes={cafesOf(region.slug)} />)}
            {
              cafes.map((cafe, i) => (
                <CoffeeSheet
                  lang={lang}
                  cafe={cafe}
                  region={regionBySlug.get(cafe.region)!}
                  prev={cafes[(i - 1 + cafes.length) % cafes.length]}
                  next={cafes[(i + 1) % cafes.length]}
                />
              ))
            }
            {
              places.map((place, i) => (
                <PlaceSheet
                  lang={lang}
                  place={place}
                  prev={places.length > 1 ? places[(i - 1 + places.length) % places.length] : undefined}
                  next={places.length > 1 ? places[(i + 1) % places.length] : undefined}
                />
              ))
            }
            <RoasterySheet lang={lang} />
            <button type="button" class="btn btn--ghost explorer__back" data-tomap hidden>
              <span aria-hidden="true">↑</span> {t('map.backToMap')}
            </button>
          </div>
        </div>
      </div>
    </section>

    <section class="catalog" aria-labelledby="catalog-title">
      <div class="wrap">
        <h2 id="catalog-title" class="display">{t('list.title')}</h2>
        {
          regions.map((region) => (
            <div class="catalog__group">
              <h3 class="catalog__region">{region.nom}</h3>
              {cafesOf(region.slug).length === 0 && (
                <p class="catalog__soon">
                  <span class="badge badge--soon">{t('region.soon')}</span> {t('region.soonText')}
                </p>
              )}
              <ul class="cards">
                {cafesOf(region.slug).map((c) => (
                  <li class:list={['card', { 'is-soldout': !c.disponible }]} data-card={c.slug}>
                    <p class="card__origin">
                      {countryName(c.pays, lang)} · {region.nom}
                      {c.localite && ` · ${c.localite}`}
                    </p>
                    <h4 class="card__title">{c.nom[lang]}</h4>
                    <p class="card__notes">{c.notes[lang].join(' · ')}</p>
                    <div class="card__actions">
                      <a href={`#${c.slug}`} data-show={c.slug} class="link">
                        {t('list.show')}
                      </a>
                      {c.disponible ? (
                        <button
                          type="button"
                          class="link link--strong link--button"
                          data-add-to-cart
                          data-item={quickItem(c)}
                          data-name={c.nom[lang]}
                          data-added={t('shop.added')}
                        >
                          {t('sheet.buy')}
                        </button>
                      ) : (
                        <span class="badge badge--soldout">{t('sheet.soldOut')}</span>
                      )}
                    </div>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </section>

    <Approach lang={lang} />
  </main>

  <Footer lang={lang} />

  <script>
    import { initExplorer } from '../../scripts/explorer';
    import { initHeroVideo } from '../../scripts/hero-video';
    import { initApproach } from '../../scripts/approach';
    initExplorer();
    initHeroVideo();
    initApproach();
  </script>
</Layout>
